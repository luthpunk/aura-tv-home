<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="20dp">

    <!-- Top Header: Icon + Title + Source/Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/headerIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_music"
            android:tint="#00F0FF" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="NOW PLAYING"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/badgeSource"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_dialog_btn"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:text="NOW PLAYING"
            android:textColor="#1DB954"
            android:textSize="11.5sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Main Content Row: Left Album Art + Right Media Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Album Art / Thumbnail -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp">

            <ImageView
                android:id="@+id/imgAlbumArt"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_media_app_pill"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />
        </FrameLayout>

        <!-- Right: Track Title, Artist, and Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Judul Lagu"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever" />

            <TextView
                android:id="@+id/txtTrackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nama Artis / Channel"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtPlaybackStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="▶ Sedang Diputar"
                android:textColor="#1DB954"
                android:textSize="11.5sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="0.03" />
        </LinearLayout>
    </LinearLayout>

    <!-- Controls Row: Prev, Play/Pause, Next -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnPopupPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/ic_np_tint"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/bg_np_round_btn"
            android:nextFocusLeft="@+id/btnPopupPrev"
            android:nextFocusUp="@+id/btnPopupPrev"
            android:nextFocusRight="@+id/btnPlayPause"
            android:nextFocusDown="@+id/btnOpenApp" />

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pause"
            android:tint="@color/ic_np_tint"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/bg_np_round_btn"
            android:nextFocusLeft="@+id/btnPopupPrev"
            android:nextFocusUp="@+id/btnPlayPause"
            android:nextFocusRight="@+id/btnPopupNext"
            android:nextFocusDown="@+id/btnOpenApp" />

        <ImageView
            android:id="@+id/btnPopupNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/ic_np_tint"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/bg_np_round_btn"
            android:nextFocusLeft="@+id/btnPlayPause"
            android:nextFocusUp="@+id/btnPopupNext"
            android:nextFocusRight="@+id/btnPopupNext"
            android:nextFocusDown="@+id/btnCloseDialog" />
    </LinearLayout>

    <!-- Bottom Action Buttons: Open App & Close/Stop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btnOpenApp"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dialog_btn"
            android:textColor="@drawable/dialog_btn_text"
            android:textSize="12.5sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:text="Buka Aplikasi"
            android:nextFocusLeft="@+id/btnOpenApp"
            android:nextFocusUp="@+id/btnPlayPause"
            android:nextFocusRight="@+id/btnCloseDialog"
            android:nextFocusDown="@+id/btnOpenApp" />

        <TextView
            android:id="@+id/btnCloseDialog"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dialog_btn"
            android:textColor="@drawable/dialog_btn_text"
            android:textSize="12.5sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:text="Tutup &amp; Hentikan"
            android:nextFocusLeft="@+id/btnOpenApp"
            android:nextFocusUp="@+id/btnPlayPause"
            android:nextFocusRight="@+id/btnCloseDialog"
            android:nextFocusDown="@+id/btnCloseDialog" />
    </LinearLayout>
</LinearLayout>
