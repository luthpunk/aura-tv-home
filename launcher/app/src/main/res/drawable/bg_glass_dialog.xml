<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smoky translucent frosted glass veil -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D9252B38"
                android:centerColor="#D91E2330"
                android:endColor="#D9171B26" />
            <corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <!-- Subtle top glass sheen -->
    <item android:top="0dp" android:bottom="220dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#28FFFFFF"
                android:endColor="#00000000" />
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
