<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted liquid glass background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#CC1C2332"
                android:centerColor="#B8141A26"
                android:endColor="#A60E131E" />
            <corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <!-- Subtle top glass sheen -->
    <item android:top="0dp" android:bottom="240dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:endColor="#00000000" />
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
